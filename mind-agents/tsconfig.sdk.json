{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/portals/**/*.ts",
    "src/types/portal.ts",
    "src/types/portals/ai-sdk.ts",
    "src/core/portal-integration.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "src/portals/examples/**"
  ]
}
