{
  "name": "symindx",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun --no-env-file run --cwd packages/agent typecheck",
    "typecheck": "bun --no-env-file run --cwd packages/agent typecheck",
    "typecheck:modules": "tsc -p packages/agent/tsconfig.json --noEmit",
    "start": "bun --no-env-file run --cwd apps/cli start",
    "cli": "bun --no-env-file run --cwd apps/cli start",
    "dev": "bun --no-env-file run --cwd apps/cli dashboard",
    "build:website": "bun --no-env-file run --cwd apps/website build",
    "typecheck:website": "bun --no-env-file run --cwd apps/website typecheck",
    "web:dev": "bun --no-env-file run --cwd apps/website dev",
    "agent": "bun --no-env-file run --cwd apps/cli start"
  }
}
