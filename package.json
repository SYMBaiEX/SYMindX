{
  "name": "symindx",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun --no-env-file run --cwd packages/runtime build",
    "typecheck": "bun --no-env-file run --cwd packages/runtime typecheck",
    "start": "bun --no-env-file packages/runtime/src/cli.ts",
    "cli": "bun --no-env-file packages/runtime/src/cli.ts",
    "dev": "bun --no-env-file packages/runtime/src/cli.ts chat",
    "legacy:build:agent": "cd mind-agents && bun run build",
    "legacy:build:website": "cd website && bun run build",
    "legacy:build:scaffolder": "cd create-symindx && bun run build",
    "legacy:cli": "cd mind-agents && bun run cli"
  }
}