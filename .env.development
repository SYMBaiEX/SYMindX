# SYMindX Development Environment Configuration

# Application
NODE_ENV=development
LOG_LEVEL=debug
SYMINDX_PORT=3000
SYMINDX_API_PORT=8080
SYMINDX_METRICS_PORT=9090
WEBSITE_PORT=3001

# Database Configuration
POSTGRES_DB=symindx_dev
POSTGRES_USER=symindx
POSTGRES_PASSWORD=dev123
DATABASE_URL=postgresql://symindx:dev123@localhost:5432/symindx_dev

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Memory Provider (SQLite for development)
MEMORY_PROVIDER=sqlite

# AI Provider Configuration
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Platform Integration Keys (optional for development)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
DISCORD_BOT_TOKEN=your_discord_bot_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Monitoring Configuration
PROMETHEUS_PORT=9091
GRAFANA_PORT=3003
GRAFANA_ADMIN_PASSWORD=admin
JAEGER_UI_PORT=16686

# Security (development keys - not secure)
JWT_SECRET=dev_jwt_secret_not_secure
ENCRYPTION_KEY=dev_encryption_key_not_secure

# Development Features
HOT_RELOAD=true
DEBUG_MODE=true
MOCK_AI_RESPONSES=false