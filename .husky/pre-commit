#!/bin/sh
# Non-mutating compile gates for the supported packages.
set -eu
cd "$(git rev-parse --show-toplevel)"
command -v bun >/dev/null 2>&1 || { echo 'Bun is required to typecheck the SYMindX packages.' >&2; exit 1; }
bun --no-env-file run --cwd packages/agent typecheck
bun --no-env-file run --cwd packages/orchestration typecheck
