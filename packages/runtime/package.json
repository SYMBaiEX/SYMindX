{
  "name": "@symindx/runtime",
  "version": "0.1.0",
  "description": "Persistent character agents with a bounded message and tool runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.4.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "symindx": "./bin/symindx.cjs"
  },
  "files": [
    "bin",
    "dist",
    "characters",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun --no-env-file scripts/build.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "bun --no-env-file src/cli.ts",
    "dev": "bun --no-env-file src/cli.ts chat",
    "cli": "bun --no-env-file src/cli.ts",
    "format:check": "prettier --check --config .prettierrc.json --no-editorconfig src scripts bin",
    "agent": "bun --no-env-file src/cli.ts agent"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "private": true
}
