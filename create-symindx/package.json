{
  "name": "create-symindx",
  "version": "0.1.0",
  "private": true,
  "description": "Bun-only local project scaffolding CLI for SYMindX",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "bin": {
    "create-symindx": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bun --no-env-file src/index.ts",
    "dev": "bun --no-env-file --watch src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.34",
    "typescript": "7.0.2",
    "@types/bun": "1.4.2"
  }
}
