        "preserveWatchOutput": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": false,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": false,
        "useDefineForClassFields": true,
        "moduleDetection": "auto",
