{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["vite.config.ts"]
}
